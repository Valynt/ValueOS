{
  "version": 2,
  "layer": "layer3",
  "description": "Layer 3 production-hardening readiness evidence requirements.",
  "maxArtifactAgeHours": 24,
  "checks": [
    {
      "id": "workflow-state-tests",
      "name": "Workflow-state tests",
      "required": true,
      "validator": "json-path-equals",
      "formatVersion": 1,
      "successPath": "success",
      "expectedValue": true,
      "requiredPaths": [
        "success",
        "summary.passed",
        "summary.failed"
      ],
      "artifacts": [
        "artifacts/layer3/workflow-state-tests.json"
      ]
    },
    {
      "id": "drift-primitive-tests",
      "name": "Drift primitive tests",
      "required": true,
      "validator": "json-path-equals",
      "formatVersion": 1,
      "successPath": "success",
      "expectedValue": true,
      "requiredPaths": [
        "success",
        "summary.passed",
        "summary.failed"
      ],
      "artifacts": [
        "artifacts/layer3/drift-primitive-tests.json"
      ]
    },
    {
      "id": "migration-head-check",
      "name": "Migration head check",
      "required": true,
      "validator": "text-markers",
      "successMarkers": [
        "CHECK: PASS"
      ],
      "failureMarkers": [
        "CHECK: FAIL",
        "ERROR",
        "FAILED"
      ],
      "artifacts": [
        "artifacts/layer3/migration-head-check.log"
      ]
    },
    {
      "id": "schema-contract-check",
      "name": "Schema contract check",
      "required": true,
      "validator": "json-path-equals",
      "formatVersion": 1,
      "successPath": "success",
      "expectedValue": true,
      "requiredPaths": [
        "success",
        "contractsValidated",
        "breakingChanges"
      ],
      "artifacts": [
        "artifacts/layer3/schema-contract-check.json"
      ]
    },
    {
      "id": "route-compatibility-check",
      "name": "Route compatibility check",
      "required": true,
      "validator": "json-path-equals",
      "formatVersion": 1,
      "successPath": "success",
      "expectedValue": true,
      "requiredPaths": [
        "success",
        "routesValidated",
        "incompatibleRoutes"
      ],
      "artifacts": [
        "artifacts/layer3/route-compatibility-check.json"
      ]
    },
    {
      "id": "tenant-isolation-tests",
      "name": "Tenant isolation tests",
      "required": true,
      "validator": "json-path-equals",
      "formatVersion": 1,
      "successPath": "success",
      "expectedValue": true,
      "requiredPaths": [
        "success",
        "suite",
        "summary.passed",
        "summary.failed"
      ],
      "artifacts": [
        "artifacts/layer3/tenant-isolation-tests.json"
      ]
    },
    {
      "id": "tenant-migration-readiness-checklist",
      "name": "Tenant migration readiness checklist artifact",
      "required": true,
      "validator": "text-markers",
      "successMarkers": [
        "Layer 3 Tenant Migration Readiness Checklist",
        "Post-migration verification"
      ],
      "failureMarkers": [
        "TODO",
        "TBD",
        "MISSING"
      ],
      "artifacts": [
        "artifacts/layer3/tenant-migration-readiness-checklist.md"
      ],
      "requiredWhen": {
        "anyChangedPathPrefixes": [
          "scripts/db/layer3/",
          "scripts/db/",
          "supabase/migrations/",
          "packages/backend/src/services/graph/",
          "packages/backend/src/lib/graph/"
        ],
        "anyChangedPatterns": [
          "**/*tenant*id*",
          "**/*tenant*_id*",
          "**/*migration*layer3*",
          "**/*layer3*tenant*"
        ],
        "envVar": "LAYER3_TENANT_MIGRATION_REQUIRED",
        "description": "Required only when Layer 3 tenant graph/migration scope changed."
      }
    }
  ],
  "controlOwnership": {
    "workflow-state-tests": {
      "paths": [
        "packages/backend/src/runtime/",
        "packages/backend/src/data/lifecycleWorkflows.ts"
      ],
      "interfaces": [
        "workflow-state-contract-v1"
      ]
    },
    "drift-primitive-tests": {
      "paths": [
        "packages/backend/src/runtime/",
        "packages/backend/src/services/realtime/"
      ],
      "interfaces": [
        "drift-primitives-v1"
      ]
    },
    "migration-head-check": {
      "paths": [
        "supabase/migrations/",
        "scripts/db/"
      ],
      "interfaces": [
        "migration-head"
      ]
    },
    "schema-contract-check": {
      "paths": [
        "packages/shared/src/domain/",
        "packages/backend/src/types/"
      ],
      "interfaces": [
        "schema-contract-v1"
      ]
    },
    "route-compatibility-check": {
      "paths": [
        "packages/backend/src/routes/",
        "packages/backend/src/api/"
      ],
      "interfaces": [
        "http-route-contract-v1"
      ]
    },
    "tenant-isolation-tests": {
      "paths": [
        "packages/backend/src/lib/supabase/",
        "packages/backend/src/services/tenant/",
        "supabase/migrations/"
      ],
      "interfaces": [
        "tenant-isolation-policy-v1"
      ]
    },
    "tenant-migration-readiness-checklist": {
      "paths": [
        "docs/cicd/",
        "scripts/ci/"
      ],
      "interfaces": [
        "tenant-migration-readiness-v1"
      ]
    }
  }
}
