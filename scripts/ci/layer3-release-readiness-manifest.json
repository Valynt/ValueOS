{
  "version": 1,
  "layer": "layer3",
  "description": "Layer 3 production-hardening readiness evidence requirements.",
  "maxArtifactAgeHours": 24,
  "checkOwnership": {
    "workflow-state-tests": {
      "paths": ["packages/backend/src/runtime", "packages/backend/src/data/lifecycleWorkflows.ts"],
      "interfaces": ["workflow-state-contract"]
    },
    "drift-primitive-tests": {
      "paths": ["packages/backend/src/lib/agent-fabric/hardening", "packages/backend/src/runtime/PolicyEngine"],
      "interfaces": ["drift-primitives"]
    },
    "migration-head-check": {
      "paths": ["supabase/migrations", "scripts/db"],
      "interfaces": ["database-migration-head"]
    },
    "schema-contract-check": {
      "paths": ["packages/shared/src/domain", "packages/backend/src/types"],
      "interfaces": ["schema-contract"]
    },
    "route-compatibility-check": {
      "paths": ["packages/backend/src/routes", "packages/backend/src/api"],
      "interfaces": ["http-route-contract"]
    },
    "tenant-isolation-tests": {
      "paths": ["packages/backend/src/services/tenant", "packages/backend/src/lib/supabase"],
      "interfaces": ["tenant-isolation"]
    },
    "tenant-migration-readiness-checklist": {
      "paths": ["docs/cicd", "scripts/ci"],
      "interfaces": ["tenant-migration-readiness"]
    }
  },
  "checks": [
    {
      "id": "workflow-state-tests",
      "name": "Workflow-state tests",
      "required": true,
      "artifacts": [
        "artifacts/layer3/workflow-state-tests.json"
      ]
    },
    {
      "id": "drift-primitive-tests",
      "name": "Drift primitive tests",
      "required": true,
      "artifacts": [
        "artifacts/layer3/drift-primitive-tests.json"
      ]
    },
    {
      "id": "migration-head-check",
      "name": "Migration head check",
      "required": true,
      "artifacts": [
        "artifacts/layer3/migration-head-check.log"
      ]
    },
    {
      "id": "schema-contract-check",
      "name": "Schema contract check",
      "required": true,
      "artifacts": [
        "artifacts/layer3/schema-contract-check.json"
      ]
    },
    {
      "id": "route-compatibility-check",
      "name": "Route compatibility check",
      "required": true,
      "artifacts": [
        "artifacts/layer3/route-compatibility-check.json"
      ]
    },
    {
      "id": "tenant-isolation-tests",
      "name": "Tenant isolation tests",
      "required": true,
      "artifacts": [
        "artifacts/layer3/tenant-isolation-tests.json"
      ]
    },
    {
      "id": "tenant-migration-readiness-checklist",
      "name": "Tenant migration readiness checklist artifact",
      "required": true,
      "artifacts": [
        "artifacts/layer3/tenant-migration-readiness-checklist.md"
      ]
    }
  ]
}
