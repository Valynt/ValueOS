    },
    {
      "id": "gitleaks-nightly",
      "workflow": ".github/workflows/nightly-governance.yml",
      "script": "scripts/ci/run-gitleaks-scan.sh",
      "version": "8.21.2",
      "mode": "history"
    },
    {
      "id": "semgrep-nightly",
      "workflow": ".github/workflows/nightly-governance.yml",
      "uses": "returntocorp/semgrep-action@v1"
