      "script": "scripts/ci/run-gitleaks-scan.sh",
      "version": "8.21.2",
      "mode": "diff"
    },
    {
      "id": "gitleaks-pr-fast",
      "workflow": ".github/workflows/pr-fast.yml",
      "script": "scripts/ci/run-gitleaks-scan.sh",
      "version": "8.21.2",
      "mode": "diff"
    },
    {
      "id": "gitleaks-pr-fast-security",
      "workflow": ".github/workflows/pr-fast.yml",
      "script": "scripts/ci/run-gitleaks-scan.sh",
      "version": "8.21.2",
      "mode": "history"
    },
    {
      "id": "semgrep-pr-fast",
      "workflow": ".github/workflows/pr-fast.yml",
      "uses": "returntocorp/semgrep-action@v1"
    },
    {
      "id": "trivy-pr-fast",
      "workflow": ".github/workflows/pr-fast.yml",
      "uses": "aquasecurity/trivy-action@0.35.0"
    },
    {
      "id": "gitleaks-main-verify",
      "workflow": ".github/workflows/main-verify.yml",
      "script": "scripts/ci/run-gitleaks-scan.sh",
      "version": "8.21.2",
      "mode": "history"
    },
    {
      "id": "semgrep-main-verify",
      "workflow": ".github/workflows/main-verify.yml",
      "uses": "returntocorp/semgrep-action@v1"
    },
    {
      "id": "trivy-main-verify",
      "workflow": ".github/workflows/main-verify.yml",
